function c() {
 if [ -z $@ ] && [ ! -z $cluster4prompt ]
 then
  ssh $ssh_opts -i $private_key -l nutanix $cluster4prompt
 else
  ssh $ssh_opts -i $private_key -l nutanix $@
 fi
}

function cinfo() {
 if [ -z $@ ] && [ ! -z $cluster4prompt ]
 then
  grep -A1 $cluster4prompt ~/.ssh/config
 else
  echo "Clustername is needed ..."
 fi

}

