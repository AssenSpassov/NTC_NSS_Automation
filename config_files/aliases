alias delivery="~/delivery.sh"

function cvm() {
 if [ "$cluster4prompt" == "git" ] || [ -z $cluster4prompt ]
 then
  ssh $ssh_opts -i $private_key -l nutanix $@
 else
  ssh $ssh_opts -i $private_key -l nutanix $cluster4prompt-cvm$@
 fi
}



alias rn="ssh -i $private_key -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -l root "

function rhost() {
 if [ "$cluster4prompt" == "git" ] || [ -z $cluster4prompt ]
 then
  ssh $ssh_opts -i $private_key -l root $@
 else
  ssh $ssh_opts -i $private_key -l root ${cluster4prompt}-host$@
 fi
}

