ssh_opts="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
private_key="~/.ssh/id_rsa"

alias n="ssh -i $private_key -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -l nutanix "
alias a="ssh -i $private_key -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no -l admin "
